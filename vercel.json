{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.vetalabs.cl" }],
      "destination": "https://vetalabs.cl/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "vetalabs.vercel.app" }],
      "destination": "https://vetalabs.cl/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "crm-consultoria-sg.vercel.app" }],
      "destination": "https://vetalabs.cl/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "vetalabs-check-your-cars.vercel.app" }],
      "destination": "https://vetalabs.cl/$1",
      "permanent": true
    }
  ]
}
