# Variables de entorno del proyecto. Solo NOMBRES y descripciones.
# Nunca pongas valores reales acá: este archivo va al repo, y el repo es público.
#
# Dónde se cargan de verdad:
#   - Edge Functions  -> Supabase → Edge Functions → Secrets
#   - /api/lead-form  -> Vercel → Settings → Environment Variables
# Copia este archivo a `.env` solo si vas a correr algo en local (`.env` está en .gitignore).

# ---------------------------------------------------------------------------
# Meta Lead Ads (Edge Function `meta-lead`)
# ---------------------------------------------------------------------------

# Cadena que tú inventas y pegas igual en Meta al dar de alta el webhook.
# Genérala con: openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=

# App secret de la app de Meta. Con esto se valida la firma X-Hub-Signature-256.
# Meta for Developers → tu app → Configuración → Básica → Clave secreta.
META_APP_SECRET=

# Token de acceso de la página (larga duración). Se usa para leer el lead desde
# Graph API. Requiere el permiso leads_retrieval.
META_PAGE_ACCESS_TOKEN=

# Versión de Graph API, formato vNN.N (ej. v21.0). Si se omite, usa v21.0.
META_GRAPH_API_VERSION=

# Id de la página de Veta Labs. Opcional: solo si quieres rechazar eventos de
# otras páginas suscritas a la misma app.
META_PAGE_ID=

# ---------------------------------------------------------------------------
# Supabase (lo inyecta la plataforma en las Edge Functions; no hay que cargarlo)
# ---------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Aviso por correo (opcional, compartido con `nuevo-lead`)
# ---------------------------------------------------------------------------

RESEND_API_KEY=
# Remitente, ej. "Leads CRM <leads@vetalabs.cl>". Por defecto usa el de pruebas de Resend.
RESEND_FROM=
